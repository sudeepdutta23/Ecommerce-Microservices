{
  "info": {
    "_postman_id": "9a1b2c3d-0000-4000-8000-ecombackend02",
    "name": "Ecom Backend Microservices",
    "description": "All APIs of the e-commerce microservices backend, routed through the API gateway (default http://localhost:8080).\n\n**Setup**: import `Ecom-Backend-Local.postman_environment.json` and select it.\n\n**Token mapping**: `Auth > Register` (or `Login`) stores `accessToken`/`refreshToken` in the environment; `Auth > Admin Login` stores `adminAccessToken`. All authenticated requests inherit `Bearer {{accessToken}}` from the collection; admin-only requests override with `{{adminAccessToken}}`. Order/notification/product ids are captured automatically by test scripts, so the folders can be run top-to-bottom (Collection Runner works too).\n\nSeed data required for catalog/order defaults: run the auth + catalog seeds (see README).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection-wide: every response must use the standard envelope.",
          "if (pm.response.headers.get('content-type')?.includes('application/json') && pm.response.code !== 204) {",
          "    const body = pm.response.json();",
          "    pm.test('response uses standard envelope', () => {",
          "        pm.expect(body).to.have.property('success');",
          "    });",
          "}"
        ]
      }
    }
  ],
  "item": [
