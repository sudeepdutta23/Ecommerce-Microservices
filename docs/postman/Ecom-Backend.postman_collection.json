    {
      "name": "Orders (order-service)",
      "item": [
        {
          "name": "Create order (idempotent)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}", "description": "Required; 8-128 chars. Generated by the pre-request script." }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"productId\": \"{{productId}}\", \"quantity\": 2 },\n    { \"productId\": \"{{productId2}}\", \"quantity\": 1 }\n  ],\n  \"shippingAddress\": {\n    \"line1\": \"42 Federation Way\",\n    \"city\": \"Kolkata\",\n    \"postalCode\": \"700001\",\n    \"country\": \"IN\"\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/orders", "host": ["{{baseUrl}}"], "path": ["api", "v1", "orders"] }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fresh key per create; the Replay request reuses this exact key.",
                  "pm.environment.set('idempotencyKey', `pm-${Date.now()}-${Math.random().toString(36).slice(2, 10)}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('order created (201)', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "if (body.success) {",
                  "    pm.environment.set('orderId', body.data.order.id);",
                  "    pm.test('order is PENDING with server-computed total', () => {",
                  "        pm.expect(body.data.order.status).to.eql('PENDING');",
                  "        pm.expect(body.data.order.totalCents).to.be.above(0);",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create order — replay same key",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}", "description": "Same key as the previous request — must replay, not duplicate." }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"productId\": \"{{productId}}\", \"quantity\": 2 },\n    { \"productId\": \"{{productId2}}\", \"quantity\": 1 }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/orders", "host": ["{{baseUrl}}"], "path": ["api", "v1", "orders"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('replayed stored response (201)', () => pm.response.to.have.status(201));",
                  "pm.test('marked as idempotent replay', () => {",
                  "    pm.expect(pm.response.headers.get('x-idempotent-replay')).to.eql('true');",
                  "});",
                  "pm.test('same order id as original', () => {",
                  "    pm.expect(pm.response.json().data.order.id).to.eql(pm.environment.get('orderId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List my orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "PENDING", "disabled": true, "description": "PENDING | PAID | SHIPPED | DELIVERED | CANCELLED" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('orders listed (200)', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Get order by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "orders", "{{orderId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('order found (200)', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Admin: update status (PENDING → PAID)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminAccessToken}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PAID\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "v1", "orders", "{{orderId}}", "status"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status changed (200)', () => pm.response.to.have.status(200));",
                  "pm.test('order is PAID', () => pm.expect(pm.response.json().data.order.status).to.eql('PAID'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel my order (only while PENDING)",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}/cancel", "host": ["{{baseUrl}}"], "path": ["api", "v1", "orders", "{{orderId}}", "cancel"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 200 if the order is still PENDING; 409 if it was already paid",
                  "// (run before the admin PAID transition to see the success path).",
                  "pm.test('cancelled (200) or state-machine rejection (409)', () => {",
                  "    pm.expect([200, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Notifications (notification-service)",
      "item": [
        {
          "name": "List my notifications",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/notifications?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "notifications"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "unreadOnly", "value": "true", "disabled": true }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('notifications listed (200)', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "// Notifications are produced asynchronously by events (welcome,",
                  "// order confirmed, status changed) — allow a moment after writes.",
                  "if (body.success && body.data.notifications.length > 0) {",
                  "    pm.environment.set('notificationId', body.data.notifications[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Mark one as read",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/notifications/{{notificationId}}/read", "host": ["{{baseUrl}}"], "path": ["api", "v1", "notifications", "{{notificationId}}", "read"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('marked read (200)', () => pm.response.to.have.status(200));",
                  "pm.test('readAt is set', () => pm.expect(pm.response.json().data.notification.readAt).to.not.be.null);"
                ]
              }
            }
          ]
        },
        {
          "name": "Mark all as read",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/notifications/read-all", "host": ["{{baseUrl}}"], "path": ["api", "v1", "notifications", "read-all"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('all marked read (200)', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Analytics (analytics-service)",
      "item": [
        {
          "name": "Ingest frontend events (batch, anonymous OK)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"events\": [\n    { \"type\": \"page.view\", \"payload\": { \"remote\": \"catalog\", \"path\": \"/products\" } },\n    { \"type\": \"product.click\", \"payload\": { \"productId\": \"{{productId}}\" } }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/events", "host": ["{{baseUrl}}"], "path": ["api", "v1", "events"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('accepted (202)', () => pm.response.to.have.status(202));",
                  "pm.test('events counted', () => pm.expect(pm.response.json().data.ingested).to.be.at.least(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ingest as authenticated user (userId attributed)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"events\": [\n    { \"type\": \"checkout.started\", \"payload\": { \"cartSize\": 3 } }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/events", "host": ["{{baseUrl}}"], "path": ["api", "v1", "events"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('accepted (202)', () => pm.response.to.have.status(202));"]
              }
            }
          ]
        },
        {
          "name": "Admin: summary report",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminAccessToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/reports/summary",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "reports", "summary"],
              "query": [
                { "key": "from", "value": "2026-01-01T00:00:00.000Z", "disabled": true },
                { "key": "to", "value": "2026-12-31T23:59:59.000Z", "disabled": true }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('report returned (200)', () => pm.response.to.have.status(200));",
                  "pm.test('report has totals, byType and byDay', () => {",
                  "    const report = pm.response.json().data.report;",
                  "    pm.expect(report).to.include.keys('totalEvents', 'byType', 'byDay');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
