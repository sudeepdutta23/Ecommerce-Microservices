    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "register"] }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Generate a unique email on first run so re-running never 409s.",
                  "if (!pm.environment.get('userEmail')) {",
                  "    pm.environment.set('userEmail', `user_${Date.now()}@example.com`);",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('registered (201)', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "if (body.success) {",
                  "    pm.environment.set('accessToken', body.data.tokens.accessToken);",
                  "    pm.environment.set('refreshToken', body.data.tokens.refreshToken);",
                  "    pm.environment.set('userId', body.data.user.id);",
                  "    pm.test('tokens captured to environment', () => {",
                  "        pm.expect(body.data.tokens.accessToken).to.be.a('string').and.not.empty;",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('logged in (200)', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (body.success) {",
                  "    pm.environment.set('accessToken', body.data.tokens.accessToken);",
                  "    pm.environment.set('refreshToken', body.data.tokens.refreshToken);",
                  "    pm.environment.set('userId', body.data.user.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('admin logged in (200)', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (body.success) {",
                  "    pm.environment.set('adminAccessToken', body.data.tokens.accessToken);",
                  "    pm.environment.set('adminRefreshToken', body.data.tokens.refreshToken);",
                  "    pm.test('admin role confirmed', () => pm.expect(body.data.user.role).to.eql('ADMIN'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "me"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('authenticated (200)', () => pm.response.to.have.status(200));",
                  "pm.test('identity matches captured userId', () => {",
                  "    pm.expect(pm.response.json().data.user.id).to.eql(pm.environment.get('userId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh (rotates tokens)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "refresh"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('refreshed (200)', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (body.success) {",
                  "    const old = pm.environment.get('refreshToken');",
                  "    pm.environment.set('accessToken', body.data.tokens.accessToken);",
                  "    pm.environment.set('refreshToken', body.data.tokens.refreshToken);",
                  "    pm.test('refresh token was rotated', () => {",
                  "        pm.expect(body.data.tokens.refreshToken).to.not.eql(old);",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout (revokes refresh token)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "logout"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('logged out (204)', () => pm.response.to.have.status(204));",
                  "pm.environment.set('refreshToken', '');"
                ]
              }
            }
          ]
        }
      ]
    },
