generator client {
  provider = "prisma-client-js"
  // Service-local output; see auth-service schema for rationale.
  output   = "../node_modules/@prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  // Identity owned by auth-service; no cross-database foreign key.
  userId          String      @map("user_id") @db.Uuid
  status          OrderStatus @default(PENDING)
  totalCents      Int         @map("total_cents")
  currency        String      @default("USD")
  shippingAddress Json?       @map("shipping_address")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  items           OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id             String @id @default(uuid()) @db.Uuid
  orderId        String @map("order_id") @db.Uuid
  productId      String @map("product_id") @db.Uuid
  // Snapshot of name/price at purchase time; catalog data changes later.
  productName    String @map("product_name")
  unitPriceCents Int    @map("unit_price_cents")
  quantity       Int
  order          Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

// Stored response for replaying duplicate POST /orders requests safely.
model IdempotencyKey {
  key        String
  userId     String   @map("user_id") @db.Uuid
  statusCode Int      @map("status_code")
  response   Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([key, userId])
  @@map("idempotency_keys")
}

// Transactional outbox: written in the same transaction as the business
// change, drained to RabbitMQ by a background worker. Guarantees an event is
// eventually published iff the transaction committed.
model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  type          String
  payload       Json
  correlationId String?   @map("correlation_id")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}
